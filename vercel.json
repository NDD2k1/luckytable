{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/taixiu",
      "dest": "/public/taixiu.html"
    },
    {
      "src": "/baucua",
      "dest": "/public/baucua.html"
    },
    {
      "src": "/bacay",
      "dest": "/public/bacay.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
